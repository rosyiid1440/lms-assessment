# ---------------------------------------------------------
# TESTING ENVIRONMENT
# Used by Vitest Integration/E2E Tests
# ---------------------------------------------------------

NODE_ENV="test"
PORT=5001

# Uses a separate logical DB or schema to prevent wiping dev data
DATABASE_URL="postgresql://lms_admin:lms_password_secure@localhost:5433/lms_test?schema=public"
REDIS_URL="redis://localhost:6379/1"

JWT_ACCESS_SECRET="test_access_secret"
JWT_REFRESH_SECRET="test_refresh_secret"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="1d"

PASSWORD_PEPPER="test_pepper"
CORS_ORIGIN="*"

STORAGE_PROVIDER="LOCAL"
STORAGE_ROOT_PATH="/tmp/lms_test_storage"

SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER="test"
SMTP_PASSWORD="test"
MAIL_FROM="test@lms.local"

QUEUE_DRIVER="MEMORY"

LOG_LEVEL="silent"
ENABLE_METRICS="false"
