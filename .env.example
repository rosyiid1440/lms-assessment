# ---------------------------------------------------------
# DEVELOPMENT ENVIRONMENT
# ---------------------------------------------------------

# Application
NODE_ENV="development"
PORT=5000

# Database & Cache
DATABASE_URL="postgresql://lms_admin:lms_password_secure@localhost:5433/lms_enterprise?schema=public"
REDIS_URL="redis://localhost:6379"

# Authentication
JWT_ACCESS_SECRET="dev_access_secret_do_not_use_in_prod"
JWT_REFRESH_SECRET="dev_refresh_secret_do_not_use_in_prod"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Security
PASSWORD_PEPPER="dev_argon2id_pepper_string_here"
CORS_ORIGIN="http://localhost:3000"

# Storage (Asset Platform)
STORAGE_PROVIDER="LOCAL"
STORAGE_ROOT_PATH="./storage"

# Mail (Notification Domain)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER="user"
SMTP_PASSWORD="password"
MAIL_FROM="noreply@lms.local"

# Queue & Event Bus
QUEUE_DRIVER="MEMORY" # Use MEMORY for local dev, REDIS for prod

# Logging & Monitoring
LOG_LEVEL="debug"
ENABLE_METRICS="false"
