model Announcement {
  id       String @id @default(uuid()) @db.Uuid
  version  Int    @default(1)
  tenantId String @db.Uuid
  courseId String @db.Uuid

  title   String @db.VarChar(255)
  content String @db.Text

  status      AnnouncementStatus @default(DRAFT)
  publishedAt DateTime?

  attachmentFileId String? @db.Uuid

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  course         Course @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attachmentFile Asset? @relation(fields: [attachmentFileId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tenantId, deletedAt])
  @@index([courseId, status])
  @@map("announcements")
}
