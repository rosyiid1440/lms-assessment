model Question {
  id        String @id @default(uuid()) @db.Uuid
  version   Int    @default(1)
  tenantId  String @db.Uuid
  subjectId String @db.Uuid

  type       QuestionType
  difficulty QuestionDifficulty
  bloomLevel BloomLevel

  phase String? @db.VarChar(10)
  cpId  String? @db.VarChar(100)
  tpId  String? @db.VarChar(100)
  atpId String? @db.VarChar(100)

  currentVersionId String? @unique @db.Uuid
  usageCount       Int     @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid

  activeVersion QuestionVersion?  @relation("CurrentQuestionVersion", fields: [currentVersionId], references: [id])
  versions      QuestionVersion[] @relation("AllQuestionVersions")

  @@index([tenantId, deletedAt])
  @@index([subjectId, type])
  @@index([tpId])
  @@map("questions")
}

model QuestionVersion {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @db.Uuid
  questionId String @db.Uuid

  versionNumber Int      @default(1)
  content       String   @db.Text
  attachments   String[] @db.Uuid

  strategyPayload Json

  estimatedTime Int @default(60) @db.SmallInt

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid

  question Question  @relation("AllQuestionVersions", fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  activeIn Question? @relation("CurrentQuestionVersion")

  @@unique([questionId, versionNumber])
  @@index([tenantId])
  @@map("question_versions")
}
