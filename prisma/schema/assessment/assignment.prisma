model Assignment {
  id       String @id @default(uuid()) @db.Uuid
  version  Int    @default(1)
  tenantId String @db.Uuid
  courseId String @db.Uuid

  title       String           @db.VarChar(255)
  instruction String           @db.Text
  status      AssignmentStatus @default(DRAFT)

  submissionType     SubmissionType  @default(FILE_AND_TEXT)
  gradingStrategy    GradingStrategy @default(MANUAL)
  latePolicy         LatePolicy      @default(REJECT)
  maxAttempts        Int             @default(1) @db.SmallInt
  maxScore           Float           @default(100) @db.Real
  scope              AssignmentScope @default(COURSE)
  assignedStudentIds String[]        @db.Uuid

  scheduledAt      DateTime?
  dueDate          DateTime
  lateDueDate      DateTime?
  attachmentFileId String?   @db.Uuid
  attachmentFile   Asset?    @relation(fields: [attachmentFileId], references: [id], onDelete: SetNull)

  rubricId String? @db.Uuid

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  submissions Submission[]

  @@index([tenantId, deletedAt])
  @@index([courseId, status])
  @@map("assignments")
}

model Submission {
  id           String @id @default(uuid()) @db.Uuid
  version      Int    @default(1)
  tenantId     String @db.Uuid
  assignmentId String @db.Uuid
  studentId    String @db.Uuid

  status           SubmissionStatus @default(DRAFT)
  currentVersionId String?          @unique @db.Uuid

  finalGrade       Float?    @db.Real
  feedback         String?   @db.Text
  gradedAt         DateTime?
  gradedById       String?   @db.Uuid
  submittedAt      DateTime?
  attachmentFileId String?   @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  activeVersion  SubmissionVersion?  @relation("CurrentSubmissionVersion", fields: [currentVersionId], references: [id])
  versions       SubmissionVersion[] @relation("AllSubmissionVersions")
  attachmentFile Asset?              @relation("SubmissionAttachment", fields: [attachmentFileId], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentId])
  @@index([tenantId])
  @@index([assignmentId, status])
  @@map("submissions")
}

model SubmissionVersion {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @db.Uuid
  submissionId String @db.Uuid

  versionNumber     Int      @default(1)
  content           String?  @db.Text
  attachmentFileIds String[] @db.Uuid

  aiMetadata Json?

  createdAt DateTime @default(now())

  submission Submission  @relation("AllSubmissionVersions", fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  activeIn   Submission? @relation("CurrentSubmissionVersion")

  @@unique([submissionId, versionNumber])
  @@index([tenantId])
  @@map("submission_versions")
}
