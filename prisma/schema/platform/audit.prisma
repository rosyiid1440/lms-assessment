// ---------------------------------------------------------
// AUDIT DOMAIN (Forensic Logging)
// ---------------------------------------------------------

model AuditLog {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  correlationId String? @db.VarChar(100)
  requestId     String? @db.VarChar(100)
  actorId       String? @db.Uuid // Usually a UserId

  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(500)

  severity AuditSeverity @default(INFO)

  resource   String  @db.VarChar(100)
  resourceId String? @db.Uuid
  action     String  @db.VarChar(100) // e.g., 'UPDATE_PASSWORD', 'EMERGENCY_ACCESS'

  createdAt DateTime @default(now())

  events      AuditEvent[]
  attachments AuditAttachment[]

  @@index([tenantId, createdAt])
  @@index([correlationId])
  @@index([actorId, resource])
  @@map("audit_logs")
}

model AuditEvent {
  id         String @id @default(uuid()) @db.Uuid
  auditLogId String @db.Uuid

  oldValues   Json?
  newValues   Json?
  diffSummary String? @db.Text

  auditLog AuditLog @relation(fields: [auditLogId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("audit_events")
}

model AuditAttachment {
  id           String @id @default(uuid()) @db.Uuid
  auditLogId   String @db.Uuid
  storedFileId String @db.Uuid // Points to StoredFile

  auditLog AuditLog @relation(fields: [auditLogId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("audit_attachments")
}
