// ---------------------------------------------------------
// WEBHOOKS & SEARCH SYNC INTEGRATION
// ---------------------------------------------------------

model WebhookEndpoint {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  name      String   @db.VarChar(100)
  url       String   @db.VarChar(500)
  secretKey String   @db.VarChar(255) // For HMAC
  topics    String[] // Array of topics e.g. ['grade.*', 'student.created']

  status     WebhookStatus @default(ACTIVE)
  maxRetries Int           @default(3) @db.SmallInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([tenantId, status])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id         String @id @default(uuid()) @db.Uuid
  endpointId String @db.Uuid

  eventId String @db.Uuid // Correlates to OutboxEvent.id
  topic   String @db.VarChar(255)
  payload Json

  status           WebhookDeliveryStatus @default(PENDING)
  attemptCount     Int                   @default(0) @db.SmallInt
  lastHttpResponse Int?                  @db.SmallInt
  lastError        String?               @db.Text

  nextRetryAt DateTime?
  createdAt   DateTime  @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([status, nextRetryAt]) // Fast poll for the Retry Worker
  @@map("webhook_deliveries")
}

model SearchIndexQueue {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  entityType String @db.VarChar(100) // e.g., 'LESSON', 'NOTE'
  entityId   String @db.Uuid
  action     String @db.VarChar(50) // 'INDEX', 'DELETE'

  status    SyncStatus @default(PENDING)
  attempt   Int        @default(0) @db.SmallInt
  lastError String?    @db.Text

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
  @@map("search_index_queues")
}
