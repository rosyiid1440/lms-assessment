// ---------------------------------------------------------
// LIVE PRESENTATION (PPTX) — Shareable, teacher-controlled
// Teacher uploads a .pptx, gets a public share link (no login).
// Students open the link and only see the current slide; only
// the teacher can move next/prev via the control endpoint.
// ---------------------------------------------------------

model LivePresentation {
  id          String  @id @default(uuid()) @db.Uuid
  version     Int     @default(1)
  tenantId    String  @db.Uuid
  createdById String? @db.Uuid

  title        String  @db.VarChar(255)
  shareCode    String  @unique @db.VarChar(64) // public link token
  fileName     String  @db.VarChar(500)        // stored filename (storage/...)
  originalName String  @db.VarChar(500)        // uploader's original file name

  currentSlide Int     @default(0) // 0-based index currently displayed
  slideCount   Int     @default(0) // total slides (reported by client after load)
  isLive       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId, deletedAt])
  @@index([createdById, deletedAt])
  @@map("live_presentations")
}