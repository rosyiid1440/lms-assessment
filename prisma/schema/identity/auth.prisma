// ---------------------------------------------------------
// AUTHENTICATION & SESSIONS
// ---------------------------------------------------------

model UserSession {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  userId   String @db.Uuid

  deviceId   String @db.VarChar(255)
  deviceName String @db.VarChar(255)
  platform   String @db.VarChar(100)
  browser    String @db.VarChar(100)
  os         String @db.VarChar(100)
  ipAddress  String @db.VarChar(45)

  isTrustedDevice Boolean   @default(false)
  loginAt         DateTime  @default(now())
  lastActivityAt  DateTime  @default(now())
  lastRefreshAt   DateTime?
  logoutAt        DateTime?
  revokedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  refreshTokens  RefreshToken[]
  loginHistories LoginHistory[]

  @@index([tenantId])
  @@index([userId, revokedAt]) // Optimized check for active sessions
  @@map("user_sessions")
}

model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @db.Uuid // Denormalized for fast filtering
  userId    String @db.Uuid
  sessionId String @db.Uuid

  hashedToken String      @unique @db.VarChar(255)
  status      TokenStatus @default(ACTIVE)
  expiresAt   DateTime

  rotatedFromTokenId String?   @db.Uuid // Track lineage for reuse detection
  rotatedAt          DateTime?
  revokedAt          DateTime?
  revokedReason      String?   @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId])
  @@index([userId, status])
  @@map("refresh_tokens")
}

model LoginHistory {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  userId    String? @db.Uuid // Nullable if login failed with invalid email
  sessionId String? @db.Uuid

  emailAttempted String? @db.VarChar(255)
  ipAddress      String  @db.VarChar(45)
  userAgent      String  @db.VarChar(255)

  status                 LoginStatus
  loginMethod            String      @db.VarChar(50)
  authenticationProvider String      @db.VarChar(50)
  failureReason          String?     @db.VarChar(255)

  createdAt DateTime @default(now())

  session UserSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tenantId])
  @@index([userId, status])
  @@index([ipAddress]) // Important for Brute Force tracking
  @@map("login_histories")
}

// Separate table specifically for brute-force lockouts 
// Keeps the PM2 cluster stateless
model LoginAttempt {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @db.Uuid
  userId        String? @db.Uuid
  email         String  @db.VarChar(255)
  ipAddress     String  @db.VarChar(45)
  success       Boolean
  failureReason String? @db.VarChar(255)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}
