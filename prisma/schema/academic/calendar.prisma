// ---------------------------------------------------------
// ACADEMIC YEAR AGGREGATE
// ---------------------------------------------------------

model AcademicYear {
  id       String @id @default(uuid()) @db.Uuid
  version  Int    @default(1)
  tenantId String @db.Uuid

  name      String             @db.VarChar(100) // e.g. "2026/2027"
  startDate DateTime           @db.Date
  endDate   DateTime           @db.Date
  status    AcademicYearStatus @default(DRAFT)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  semesters Semester[]
  courses   Course[]

  @@unique([tenantId, name]) // A tenant cannot have two "2026/2027"
  @@index([tenantId, deletedAt])
  @@index([tenantId, status])
  @@map("academic_years")
}

// ---------------------------------------------------------
// SEMESTER
// ---------------------------------------------------------

model Semester {
  id             String @id @default(uuid()) @db.Uuid
  version        Int    @default(1)
  tenantId       String @db.Uuid
  academicYearId String @db.Uuid

  name      String         @db.VarChar(100)
  type      SemesterType
  startDate DateTime       @db.Date
  endDate   DateTime       @db.Date
  status    SemesterStatus @default(DRAFT)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  classes            Class[]
  enrollments        StudentEnrollment[]
  teacherAssignments TeacherAssignment[]
  courses            Course[]

  @@unique([academicYearId, type]) // An academic year can only have one ODD and one EVEN semester
  @@index([tenantId, deletedAt])
  @@index([tenantId, status])
  @@map("semesters")
}
