// ---------------------------------------------------------
// DYNAMIC GRADE FORMULA ENGINE
// ---------------------------------------------------------

model GradeFormula {
  id       String @id @default(uuid()) @db.Uuid
  version  Int    @default(1)
  tenantId String @db.Uuid

  courseId        String                 @unique @db.Uuid
  calculationType FormulaCalculationType @default(WEIGHTED_AVERAGE)

  passingScore Float @default(75.0) @db.Real

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  components GradeFormulaComponent[]

  @@index([tenantId])
  @@map("grade_formulas")
}

model GradeFormulaComponent {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @db.Uuid
  formulaId String @db.Uuid

  sourceType       GradeSourceType // e.g., ASSIGNMENT, EXAM
  weightPercentage Float           @db.Real // e.g., 30.0 for 30%
  dropLowest       Boolean         @default(false)

  formula GradeFormula @relation(fields: [formulaId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([formulaId, sourceType])
  @@index([tenantId])
  @@map("grade_formula_components")
}
