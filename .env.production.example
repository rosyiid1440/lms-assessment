# ---------------------------------------------------------
# PRODUCTION ENVIRONMENT (aaPanel)
# ---------------------------------------------------------

# Application
NODE_ENV="production"
PORT=5000

# Database & Cache (Routed through Docker Compose internal network)
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}?schema=public"
REDIS_URL="redis://redis:6379"

# Authentication
# IMPORTANT: Generate strong random strings for these (e.g., openssl rand -base64 32)
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="30d"

# Security
# IMPORTANT: Never change the pepper after initial deployment, or all passwords invalidate
PASSWORD_PEPPER=""
CORS_ORIGIN="https://lms.yourschool.sch.id"

# Storage (Asset Platform)
STORAGE_PROVIDER="LOCAL"
STORAGE_ROOT_PATH="/app/storage"

# Mail (Notification Domain)
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASSWORD=""
MAIL_FROM="akademik@yourschool.sch.id"

# Queue & Event Bus
QUEUE_DRIVER="REDIS"

# Logging & Monitoring
LOG_LEVEL="info"
ENABLE_METRICS="true"
