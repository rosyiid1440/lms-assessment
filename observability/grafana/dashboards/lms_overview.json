{
  "title": "LMS Enterprise Dashboard",
  "timezone": "browser",
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP RPS",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(lms_http_requests_total[1m])",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Database Query Latency (P95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(lms_db_query_duration_seconds_bucket[5m])) by (le, operation))",
          "legendFormat": "{{operation}} P95"
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Outbox Oldest Pending (s)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "lms_outbox_oldest_pending_seconds",
          "legendFormat": "Seconds"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Outbox Dead Letters",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "lms_outbox_deadletter_total",
          "legendFormat": "Dead Letters"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Event Loop Delay (ms)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "rate(nodejs_eventloop_lag_seconds_sum[1m]) / rate(nodejs_eventloop_lag_seconds_count[1m]) * 1000",
          "legendFormat": "Avg Loop Delay (ms)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Worker Job Processing Rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "rate(lms_worker_status_total{status=\"SUCCESS\"}[1m])",
          "legendFormat": "{{worker}} Success Rate"
        },
        {
          "expr": "rate(lms_worker_status_total{status=\"FAILED\"}[1m])",
          "legendFormat": "{{worker}} Fail Rate"
        }
      ]
    }
  ]
}
